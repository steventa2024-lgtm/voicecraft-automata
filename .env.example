# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional for local development with Lovable-managed Google auth.
# Hosted Lovable builds use /~oauth/initiate automatically.
VITE_LOVABLE_OAUTH_BROKER_URL=https://id-preview--YOUR_PROJECT_ID.lovable.app/~oauth/initiate
# Hosted origin used as the safe OAuth return target when developing on localhost.
VITE_PUBLIC_APP_URL=https://id-preview--YOUR_PROJECT_ID.lovable.app

# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_DOWNLOAD_BUCKET=zeropulse-releases

# Exact deployed origin, without a trailing slash
PUBLIC_APP_URL=https://your-zeropulse-domain.example

# Comma-separated fallback administrators. Prefer profiles.is_admin in production.
ADMIN_EMAILS=owner@example.com

# Separate owner-only key generator. Store only the PBKDF2 verifier, never the password.
KEYGEN_ADMIN_USERNAME=replace-with-private-admin-username
KEYGEN_ADMIN_PASSWORD_HASH=pbkdf2-sha256.310000.BASE64URL_SALT.BASE64URL_DIGEST
KEYGEN_SESSION_SECRET=replace-with-at-least-32-random-characters

# At least 32 random characters. Keep both server-only.
RUNNER_TOKEN_SECRET=replace-with-a-long-random-runner-secret
DOWNLOAD_SIGNING_SECRET=replace-with-a-different-long-random-download-secret

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_BUILDER_PRO=price_REPLACE_ME
STRIPE_PRICE_ARCHITECT=price_REPLACE_ME
# Stable, non-secret label required by current Stripe Checkout API versions.
STRIPE_INTEGRATION_IDENTIFIER=zeropulse_vqkmtzra

# Stripe endpoint for Lovable hosting:
# https://YOUR-DOMAIN/api/public/stripe-webhook

# Cloudflare R2 private bucket (recommended in production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zeropulse-private-downloads
R2_JAVA_OBJECT_KEY=releases/ZeroPulseCompanion-win32-x64.zip
R2_BEDROCK_OBJECT_KEY=releases/ZeroPulseBedrockGateway.zip
