# Minecraft Java Edition target (use "Open to LAN" and copy the port shown in chat)
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=ZeroPulse
MC_VERSION=1.21.1       # canonical architecture registry target
MC_AUTH=offline          # or "microsoft" for online-mode servers
# Detailed block states require operator rights on the target server.
# Never publicly expose an offline-mode Minecraft server.
PLACEMENT_MODE=command

# Local authenticated WebSocket. The desktop app generates this token itself.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_AUTH_TOKEN=replace-with-at-least-24-random-characters

# Account API used to enforce subscription limits. Builds are refused when this is unset.
ZP_API_URL=http://127.0.0.1:8080

# Throttle: blocks placed between event-loop yields
BLOCKS_PER_TICK=24
