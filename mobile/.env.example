# Same Supabase project as the website. Publishable key only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production must be https. Development builds also allow http://127.0.0.1,
# localhost, and private LAN addresses so a phone on the same Wi-Fi can reach
# a computer running the cloud API.
EXPO_PUBLIC_VOICECRAFT_API_URL=http://127.0.0.1:8787
