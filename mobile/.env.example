# Same existing Supabase project used by the VoiceCraft website.
# Publishable key only — NEVER place a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# HTTPS endpoint where the future authenticated VoiceCraft Cloud mobile API runs.
# Must be a real reachable server, not an example or browser dashboard.
EXPO_PUBLIC_VOICECRAFT_API_URL=https://cloud.example.com
